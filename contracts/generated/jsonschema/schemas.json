{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SourceFingerprint": {
      "additionalProperties": false,
      "properties": {
        "build_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Build Digest",
          "type": "string"
        },
        "commit": {
          "pattern": "^(?:[a-f0-9]{40}|UNCOMMITTED)$",
          "title": "Commit",
          "type": "string"
        },
        "dirty_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dirty Digest",
          "type": "string"
        }
      },
      "required": [
        "build_digest",
        "commit",
        "dirty_digest"
      ],
      "title": "SourceFingerprint",
      "type": "object"
    },
    "BootstrapRequest": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_token": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Bootstrap Token",
          "type": "string"
        },
        "owner_name": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Owner Name",
          "type": "string"
        }
      },
      "required": [
        "bootstrap_token",
        "owner_name"
      ],
      "title": "BootstrapRequest",
      "type": "object"
    },
    "SessionRead": {
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "format": "uuid",
          "title": "Principal Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "permissions": {
          "items": {
            "type": "string"
          },
          "title": "Permissions",
          "type": "array"
        }
      },
      "required": [
        "principal_id",
        "tenant_id",
        "permissions"
      ],
      "title": "SessionRead",
      "type": "object"
    },
    "LeaseRead": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "fencing_epoch": {
          "exclusiveMinimum": 0,
          "title": "Fencing Epoch",
          "type": "integer"
        },
        "lease_expires_at": {
          "format": "date-time",
          "title": "Lease Expires At",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "task_id",
        "fencing_epoch",
        "lease_expires_at"
      ],
      "title": "LeaseRead",
      "type": "object"
    },
    "ArtifactRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "state": {
          "enum": [
            "STAGING",
            "AVAILABLE",
            "QUARANTINED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "task_id",
        "attempt_id",
        "sha256",
        "size_bytes",
        "state"
      ],
      "title": "ArtifactRead",
      "type": "object"
    },
    "TaskRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/TaskState"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "active_attempt_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Attempt Id"
        }
      },
      "required": [
        "id",
        "project_id",
        "title",
        "state",
        "revision"
      ],
      "title": "TaskRead",
      "type": "object"
    },
    "TaskState": {
      "enum": [
        "DRAFT",
        "READY",
        "RUNNING",
        "WAITING_APPROVAL",
        "VERIFYING",
        "CHANGES_REQUIRED",
        "BLOCKED",
        "ACCEPTED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "TaskState",
      "type": "string"
    },
    "SnapshotRead": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "cursor": {
          "minimum": 0,
          "title": "Cursor",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskRead"
          },
          "maxItems": 200,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "cursor",
        "tasks"
      ],
      "title": "SnapshotRead",
      "type": "object"
    },
    "WorkspaceRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "trust_class": {
          "enum": [
            "DISPOSABLE_TEST",
            "TRUSTED_LOCAL",
            "UNTRUSTED"
          ],
          "title": "Trust Class",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "trust_class"
      ],
      "title": "WorkspaceRead",
      "type": "object"
    },
    "WorkspaceList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/WorkspaceRead"
          },
          "maxItems": 200,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "WorkspaceList",
      "type": "object"
    },
    "ProjectRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "name",
        "revision"
      ],
      "title": "ProjectRead",
      "type": "object"
    },
    "ProjectList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ProjectRead"
          },
          "maxItems": 200,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ProjectList",
      "type": "object"
    },
    "ObjectiveRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "goal": {
          "maxLength": 4000,
          "minLength": 10,
          "title": "Goal",
          "type": "string"
        },
        "constraints": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "expected_outputs": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Expected Outputs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "project_id",
        "goal",
        "constraints",
        "expected_outputs"
      ],
      "title": "ObjectiveRead",
      "type": "object"
    },
    "PlanRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "objective_id": {
          "format": "uuid",
          "title": "Objective Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "assumptions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        }
      },
      "required": [
        "id",
        "project_id",
        "objective_id",
        "revision",
        "assumptions",
        "acceptance_criteria"
      ],
      "title": "PlanRead",
      "type": "object"
    },
    "VerificationReport": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              },
              "evidence_ids": {
                "minItems": 1
              }
            },
            "required": [
              "exit_code"
            ]
          }
        }
      ],
      "properties": {
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "verification_run_id": {
          "format": "uuid",
          "title": "Verification Run Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "fencing_epoch": {
          "exclusiveMinimum": 0,
          "title": "Fencing Epoch",
          "type": "integer"
        },
        "profile_version": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Profile Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceFingerprint"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ],
          "title": "Result",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "idempotency_key",
        "correlation_id",
        "verification_run_id",
        "task_id",
        "attempt_id",
        "fencing_epoch",
        "profile_version",
        "source",
        "result",
        "exit_code",
        "evidence_ids"
      ],
      "title": "VerificationReport",
      "type": "object"
    },
    "VerificationRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "profile_version": {
          "title": "Profile Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceFingerprint"
        },
        "result": {
          "enum": [
            "NOT_RUN",
            "RUNNING",
            "PASS",
            "FAIL",
            "BLOCKED"
          ],
          "title": "Result",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        }
      },
      "required": [
        "id",
        "task_id",
        "attempt_id",
        "profile_version",
        "source",
        "result",
        "exit_code"
      ],
      "title": "VerificationRead",
      "type": "object"
    },
    "ProjectCreate": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "correlation_id",
        "name",
        "workspace_id"
      ],
      "title": "ProjectCreate",
      "type": "object"
    },
    "ObjectiveCreate": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "goal": {
          "maxLength": 4000,
          "minLength": 10,
          "title": "Goal",
          "type": "string"
        },
        "constraints": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Constraints",
          "type": "array"
        },
        "expected_outputs": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Expected Outputs",
          "type": "array"
        }
      },
      "required": [
        "idempotency_key",
        "correlation_id",
        "project_id",
        "goal",
        "constraints",
        "expected_outputs"
      ],
      "title": "ObjectiveCreate",
      "type": "object"
    },
    "PlanCreate": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "objective_id": {
          "format": "uuid",
          "title": "Objective Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "assumptions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Assumptions",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        }
      },
      "required": [
        "idempotency_key",
        "correlation_id",
        "project_id",
        "objective_id",
        "expected_revision",
        "assumptions",
        "acceptance_criteria"
      ],
      "title": "PlanCreate",
      "type": "object"
    },
    "TaskCreate": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "role_id": {
          "pattern": "^(?:MGR|EXP)-\\d{2,3}$",
          "title": "Role Id",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Depends On",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "idempotency_key",
        "correlation_id",
        "project_id",
        "plan_id",
        "title",
        "role_id",
        "acceptance_criteria"
      ],
      "title": "TaskCreate",
      "type": "object"
    },
    "TaskAction": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "action": {
          "enum": [
            "ready",
            "cancel",
            "retry",
            "approve",
            "reject"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "approval_ref": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Ref"
        }
      },
      "required": [
        "idempotency_key",
        "correlation_id",
        "expected_revision",
        "action",
        "reason"
      ],
      "title": "TaskAction",
      "type": "object"
    },
    "ClaimRequest": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        }
      },
      "required": [
        "idempotency_key",
        "correlation_id",
        "project_id",
        "capabilities"
      ],
      "title": "ClaimRequest",
      "type": "object"
    },
    "AttemptReport": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "STOPPED",
                  "PRODUCED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "receipt_id": {
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "receipt_id"
            ]
          }
        }
      ],
      "properties": {
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "fencing_epoch": {
          "exclusiveMinimum": 0,
          "title": "Fencing Epoch",
          "type": "integer"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "state": {
          "enum": [
            "RUNNING",
            "CANCEL_REQUESTED",
